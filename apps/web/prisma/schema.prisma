generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model project_members {
  project_id String
  user_id    String
  role       ProjectRole
  created_at DateTime    @default(now())
  updated_at DateTime
  projects   projects    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users      users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@index([project_id, role])
  @@index([user_id])
}

model project_versions {
  id         String   @id
  project_id String
  snapshot   Json
  message    String?
  created_by String?
  created_at DateTime @default(now())
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([created_by])
  @@index([project_id, created_at(sort: Desc)])
}

model projects {
  id               String             @id
  name             String
  description      String?
  latest_snapshot  Json
  created_at       DateTime           @default(now())
  updated_at       DateTime
  project_members  project_members[]
  project_versions project_versions[]
  share_tokens     share_tokens[]
  import_jobs      import_jobs[]

  @@index([created_at])
  @@index([updated_at])
}

model share_tokens {
  id         String    @id
  project_id String
  token      String    @unique
  name       String?
  expires_at DateTime?
  revoked_at DateTime?
  created_by String
  created_at DateTime  @default(now())
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([token])
}

model users {
  id              String            @id
  clerkId         String            @unique
  email           String            @unique
  name            String?
  avatar_url      String?
  created_at      DateTime          @default(now())
  updated_at      DateTime
  project_members project_members[]
  import_jobs     import_jobs[]

  @@index([clerkId])
}

model import_jobs {
  id          String   @id @default(cuid())
  project_id  String
  user_id     String
  status      String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  progress    Int      @default(0) // 0-100
  phase       String?  // current phase name
  result      Json?    // ProjectSnapshot on success
  error       String?  // error message on failure
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  projects    projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([user_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}
